pipeline {
    agent any

    stages {
        stage('Unit Tests - Backened') {
            agent{
                docker{
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            environment {
                GOCACHE = '/tmp/go-cache'
                HOME = '/tmp'
            }
            steps {
                dir('bugtracker-backend') {
                    sh '''
                        mkdir -p $GOCACHE
                        go test -v ./...
                    '''
                }
            }
        }
    }
}